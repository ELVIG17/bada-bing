.header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(26, 27, 34, 0.85);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 14px 0;
}

.brand {
  font-weight: 800;
  letter-spacing: 0.2px;
  color: var(--yellow);
}

.nav {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.nav-link {
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 10px;
  color: var(--text);
  opacity: 0.9;
}

.nav-link:hover {
  border-color: var(--border2);
  box-shadow: 0 0 0 2px rgba(247, 198, 0, 0.08) inset;
}

.nav-link.active {
  border-color: rgba(247, 198, 0, 0.55);
  background: rgba(247, 198, 0, 0.1);
  color: var(--yellow2);
  opacity: 1;
}